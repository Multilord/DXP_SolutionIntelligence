# Copy to .env and fill secrets locally. Never commit your real .env.
DATABASE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=solution_atlas

# Required for the full AI pipeline. disabled is explicitly a non-AI demo.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# atlas uses the configured Atlas Vector Search index; local uses exact cosine
# over genuine Gemini vectors for small-corpus development, without GPU inference.
VECTOR_BACKEND=atlas
MONGODB_VECTOR_INDEX=atlas_semantic
ATLAS_ALLOWED_HOSTS=

# Optional source sync. These are service credentials, not application user auth.
# SAP/KB/ticket feeds must expose the schema in CONNECTORS.md.
KB_FEED_URL=
KB_FEED_TOKEN=
TICKET_FEED_URL=
TICKET_FEED_TOKEN=
SAP_FEED_URL=
SAP_FEED_TOKEN=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
